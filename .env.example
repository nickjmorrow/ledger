# Copy to .env (gitignored) and fill in. Read by scripts/generate-project.sh, which bakes these into the apps' Info.plist.

# Apple Developer team ID, needed only for iOS device builds.
DEVELOPMENT_TEAM=
# Default sync hub for the apps (Settings can override), like http://hub.example.ts.net:8455. Plain HTTP is fine inside a Tailscale tunnel.
LEDGER_HUB_URL=
# This device's token from the hub's tokens.json.
LEDGER_HUB_TOKEN=
# Host header to send, only if you connect to the hub by IP address.
LEDGER_HUB_HOST=

# The variables below are not read from .env; export them in your shell when you need them.
# Database file for the CLI, the MCP server and the apps (default ~/Library/Application Support/Ledger/ledger.sqlite).
# LEDGER_DB=/tmp/ledger-demo.sqlite
# The apps don't sync a LEDGER_DB database unless this is 1.
# LEDGER_SYNC=1
# Device name recorded on changes; `hub` on the hub server.
# LEDGER_DEVICE=hub
# MCP server only: path to the ledger binary (default: ledger on PATH, then ~/.local/bin/ledger).
# LEDGER_BIN=/path/to/ledger
# MCP server only: set to 0 to skip the background `ledger sync` around tool calls.
# LEDGER_AUTOSYNC=1
