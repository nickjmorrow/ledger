# Copy to .env (gitignored) and fill in. Read by scripts/generate-project.sh.
# Apple Developer team ID, needed only for iOS device builds.
DEVELOPMENT_TEAM=
# Default sync hub for the apps (Settings can override). Plain HTTP over Tailscale; host header only if you connect by IP.
LEDGER_HUB_URL=
LEDGER_HUB_TOKEN=
LEDGER_HUB_HOST=
